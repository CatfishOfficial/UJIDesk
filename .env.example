# Used by api/recognize.ts (server-side only — never shipped to the browser).
# Set these in the Vercel project's Environment Variables for the deployed
# function to work; for local testing of the function, run `vercel env pull`
# or `vercel dev` after setting them there (plain `npm run dev` has no function
# runtime, so /api/recognize won't exist locally without the Vercel CLI).

# Required. The reader won't work without it (returns a 500 with no retries).
OPENAI_API_KEY=

# Optional, for real per-IP rate limiting (20 requests / 10 min). Set up a
# Redis database under the project's Storage tab (Upstash) and connect it —
# Vercel injects one of these two pairs automatically, @upstash/redis reads
# either. Without one of these, rate limiting is skipped entirely (fails
# open), not enforced with a weaker fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# — or —
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Set to this site's own deployed URL (e.g. https://your-app.vercel.app)
# to reject requests whose Origin header doesn't match — stops other sites from
# calling this endpoint directly with your key. Unset = no check.
ALLOWED_ORIGIN=

# Accounts (Supabase). Both are safe to ship to the browser: the publishable
# key only does what the row-level security in supabase/migrations allows.
# vite.config.ts bakes in exactly these two names (no VITE_ prefix, so no other
# variable can leak into the page). Without them, accounts stay hidden and UJI
# keeps everything on the device. For local dev put them in .env.local
# (git-ignored via *.local); on Vercel, add them for every environment and
# redeploy, since they're read at build time.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
