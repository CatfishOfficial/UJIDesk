# Used by api/recognize.ts (server-side only — never shipped to the browser).
# Set this in the Vercel project's Environment Variables for the deployed
# function to work; for local testing of the function, run `vercel env pull`
# or `vercel dev` after setting it there (plain `npm run dev` has no function
# runtime, so /api/recognize won't exist locally without the Vercel CLI).
OPENAI_API_KEY=
